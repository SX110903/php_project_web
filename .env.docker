# Docker Environment Variables
# Copia este archivo a .env para desarrollo local

# Application
APP_ENV=development
APP_DEBUG=true
APP_PORT=8080

# Database
DB_NAME=secure_app_db
DB_USER=root
DB_PASSWORD=root
MYSQL_PORT=3306

# Redis (opcional)
REDIS_PASSWORD=secret
REDIS_PORT=6379

# phpMyAdmin (opcional)
PMA_PORT=8081

# Nginx (producción)
NGINX_PORT=80
NGINX_SSL_PORT=443
